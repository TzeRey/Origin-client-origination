# =============================================================================
# Origin: environment variables
#
#   1. Copy this file to a new file named `.env` in the project root:
#          Windows (PowerShell):  Copy-Item .env.example .env
#          macOS / Linux:         cp .env.example .env
#   2. Fill in the keys you have. Leave the others blank or commented out.
#   3. NEVER commit `.env` (it is in .gitignore) and never paste keys into code.
#
# Keys are read ONLY by the local server (server/server.js). They are never sent to the browser.
# With no keys at all you can still run the keyless demo:  npm run start:mock
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED for live research and email drafting: ONE language-model key
# -----------------------------------------------------------------------------
# Claude Sonnet via OpenRouter (https://openrouter.ai/keys). Also powers live web search.
OPENROUTER_API_KEY=

# Optional: override the model (default: anthropic/claude-sonnet-5.5)
# OUTREACH_MODEL=

# Alternative to OpenRouter: the Anthropic API directly (https://console.anthropic.com/).
# Only used if OPENROUTER_API_KEY is empty.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# -----------------------------------------------------------------------------
# STRONGLY RECOMMENDED: sanctions & PEP screening
# -----------------------------------------------------------------------------
# OpenSanctions API key (https://www.opensanctions.org/api/). Without it every dossier is
# marked "Not screened" and the email draft requires a compliance-clearance confirmation.
# Check the OpenSanctions licence: commercial use needs a paid licence.
OPENSANCTIONS_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL enrichment (the agent skips any tool whose key is missing)
# -----------------------------------------------------------------------------
# CourtListener token (https://www.courtlistener.com/help/api/): raises court-record rate limits.
COURTLISTENER_TOKEN=

# GitHub personal access token (no scopes needed): raises public-profile lookup rate limits.
# GITHUB_TOKEN=

# Firecrawl (https://www.firecrawl.dev/): deeper page scraping for the web agents.
# If unset, Claude's built-in web search is used instead.
# FIRECRAWL_API_KEY=

# OpenAlex "polite pool": your contact email for faster publication lookups. Not a secret.
# OPENALEX_MAILTO=

# -----------------------------------------------------------------------------
# DISABLED by default: USPTO patent search
# -----------------------------------------------------------------------------
# The patent integration is off. To turn it on you need BOTH lines below.
# USPTO_ENABLED=true
# USPTO_API_KEY=
# USPTO_API_BASE=

# -----------------------------------------------------------------------------
# Server (all optional)
# -----------------------------------------------------------------------------
# PORT=8787
# HOST=127.0.0.1
# Where the audit log (outreach-audit.jsonl) is written. Default: ./logs (git-ignored)
# OUTREACH_AUDIT_DIR=
# Audit-log entries name the people who were researched, so they expire automatically.
# Days to keep them (default 30). 0 switches automatic deletion off (not recommended).
# AUDIT_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Development / testing only
# -----------------------------------------------------------------------------
# Force the keyless demo mode (same as `npm run start:mock`):
# OUTREACH_MOCK=1
# Skip the artificial delays in demo mode:
# OUTREACH_MOCK_FAST=1
# Or scale them (the hosted Vercel demo uses 0.5, about 5 seconds per research run):
# OUTREACH_MOCK_SPEED=0.5
